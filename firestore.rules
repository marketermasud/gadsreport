rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // All authenticated accounts use the same application features, but each
    // account's entire workspace is private to that Firebase Authentication UID.
    match /workspaces/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Shared, non-sensitive application settings. Any signed-in account can
    // read/update these, so the UI configuration remains common across accounts.
    match /settings/{settingsId} {
      allow read, write: if signedIn();
    }

    // Default-deny everything else, including the legacy global client data.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
